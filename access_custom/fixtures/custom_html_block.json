  "script": "let wrapper = root_element;\n\n// Fetch all active companies excluding test and appraisal companies\nfrappe.db.get_list('Company', {\n    fields: ['name', 'company_name', 'abbr'],\n    filters: [\n        ['name', 'not in', ['Appraisal Practice Company', 'test customer']]\n    ],\n    limit: 0\n}).then(companies => {\n    \n    // Sort companies strictly in alphabetical order (A to Z)\n    let sortedCompanies = companies.map(c => c.name).sort((a, b) => a.localeCompare(b));\n\n    function getDisplayInfo(entityStr) {\n        let name = entityStr;\n        let tag = entityStr;\n        let upper = entityStr.toUpperCase();\n\n        if (upper.includes('SINGAPORE') || upper.includes('SEA')) tag = 'SEA';\n        else if (upper.includes('MENA')) tag = 'MENA';\n        else if (upper.includes('UNITED STATES') || upper.includes('USA')) tag = 'USA';\n        else if (upper.includes('AFFORDABLE QUALITY HEALTH') || upper === 'AQH') tag = 'AQH';\n        else if (upper.includes('QUALITY HEALTHCARE ACCESS') || upper === 'QHA') tag = 'QHA';\n        else if (upper.includes('LO') || upper.includes('AHI-LO')) tag = 'LO';\n        else if (upper.includes('GLOBAL') || entityStr === 'Global') tag = 'Global';\n\n        return { name, tag };\n    }\n\n    function getTagStyle(tag) {\n        const t = tag.toUpperCase();\n        if (t === 'SEA') return 'color: #3b82f6; background: #dbeafe;'; \n        if (t === 'MENA') return 'color: #a855f7; background: #f3e8ff;'; \n        if (t === 'USA') return 'color: #f97316; background: #ffedd5;'; \n        if (t === 'AQH') return 'color: #22c55e; background: #dcfce7;'; \n        if (t === 'QHA') return 'color: #14b8a6; background: #ccfbf1;'; \n        if (t === 'LO') return 'color: #8b5cf6; background: #ede9fe;'; \n        return 'color: #64748b; background: #f1f5f9;'; \n    }\n\n    let html = '<div style=\"display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;\">';\n\n    const pillars = [\n        { name: 'Human Resources', dbDept: 'Human Resource', icon: '👥', bg: '#f0fdf4' },\n        { name: 'Finance', dbDept: 'Finance', icon: '💰', bg: '#fef3c7' },\n        { name: 'Procurement', dbDept: 'Procurement', icon: '📦', bg: '#eff6ff' },\n        { name: 'Communications', dbDept: 'Communications', icon: '📢', bg: '#fce7f3' },\n        { name: 'Holiday Policies', dbDept: 'Holiday Policies', icon: '🗓️', bg: '#ecfeff' }\n    ];\n\n    pillars.forEach(p => {\n        html += `\n        <div style=\"background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px;\">\n            <div style=\"display: flex; align-items: center; gap: 10px; margin-bottom: 15px; padding-bottom: 15px; border-bottom: 1px solid #f1f5f9;\">\n                <span style=\"font-size: 16px; background: ${p.bg}; padding: 6px 8px; border-radius: 6px;\">${p.icon}</span>\n                <h3 style=\"font-size: 15px; font-weight: 600; color: #0f172a; margin: 0; font-family: inherit;\">${p.name}</h3>\n            </div>\n            <ul style=\"list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px;\">`;\n\n        sortedCompanies.forEach(companyName => {\n            let info = getDisplayInfo(companyName);\n            let tagStyle = getTagStyle(info.tag);\n            let linkUrl = `/app/company-policy?department=${encodeURIComponent(p.dbDept)}&office_entity=${encodeURIComponent(companyName)}`;\n\n            html += `\n            <li>\n                <a href=\"${linkUrl}\" style=\"display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: #f8fafc; border-radius: 6px; color: #334155; text-decoration: none; font-size: 12px; font-weight: 500; font-family: inherit; transition: background 0.2s;\" onmouseover=\"this.style.background='#f1f5f9'\" onmouseout=\"this.style.background='#f8fafc'\">\n                    <span>${info.name}</span>\n                    <span style=\"font-size: 10px; font-weight: 600; padding: 2px 6px; border-radius: 4px; ${tagStyle}\">${info.tag}</span>\n                </a>\n            </li>`;\n        });\n\n        html += `</ul></div>`;\n    });\n\n    html += `</div>`;\n    \n    let container = wrapper.querySelector('#access-policy-grid');\n    if (container) {\n        container.innerHTML = html;\n    } else {\n        wrapper.innerHTML = html;\n    }\n});\n",
  "style": null
 }
